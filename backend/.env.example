# AdTech Platform - Environment Configuration

# Server Configuration
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Turbospike Database Configuration (Aerospike Fork)
# High-performance NoSQL database for real-time ad serving
TURBOSPIKE_HOSTS=localhost:3000,localhost:3001,localhost:3002
TURBOSPIKE_NAMESPACE=adtech
TURBOSPIKE_TTL=0
TURBOSPIKE_MAX_RETRIES=3
TURBOSPIKE_TIMEOUT=1000

# PostgreSQL Database Configuration (Relational data)
# Used for: User management, campaign configuration, billing
DATABASE_URL=postgresql://adtech:password@localhost:5432/adtech_production

# Redis Configuration (Caching layer)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT Authentication
# SECURITY: Generate a strong secret for production using: openssl rand -base64 64
# The JWT_SECRET MUST be at least 32 characters and random in production
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# External Services
# DMP Third-party data providers
EXPERIAN_API_KEY=
ORACLE_DMP_KEY=
LIVERAMP_API_KEY=
LOTAME_API_KEY=
FOURSQUARE_API_KEY=

# Ad Exchanges
OPENX_API_KEY=
PUBMATIC_API_KEY=
RUBICON_API_KEY=
APPNEXUS_API_KEY=
GOOGLE_ADX_KEY=

# Monitoring & Observability
SENTRY_DSN=
NEW_RELIC_LICENSE_KEY=
PROMETHEUS_PORT=9090

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Feature Flags
ENABLE_ARBITRAGE=true
ENABLE_AI_BIDDING=true
ENABLE_FRAUD_DETECTION=true
ENABLE_RETARGETING=true

# Performance Tuning
MAX_BID_RESPONSE_TIME_MS=50
MAX_AD_SELECTION_TIME_MS=5
IMPRESSION_BATCH_SIZE=1000
BID_REQUEST_TIMEOUT_MS=100
